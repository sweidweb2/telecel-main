# Copy to .env.local and fill in. Never commit real values (the repo is public).
# Share secrets only through the team password manager — not chat or email.
# Setup guide: docs/04-runbooks/environment.md

# --- Site -------------------------------------------------------------------
# Public origin, no trailing slash. Used for canonical URLs, sitemap and auth
# email links. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "false" on staging/UAT so search engines never index them.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Ops safety valve: when "1" / "true", ignore site_settings maintenance Level 1/2
# (use if nobody can reach /dashboard/settings to turn maintenance off).
MAINTENANCE_FORCE_OFF=false

# --- Supabase (Dashboard → Project Settings → API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key — safe in the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in (optional) -----------------------------------------------
# "true" shows "Continue with Google" once the provider is configured in
# Supabase Auth (Dashboard → Authentication → Providers → Google).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Only for the local Supabase CLI stack (supabase/config.toml):
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Cloudflare Turnstile (form spam protection) ------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated hostnames Turnstile tokens must come from, e.g. telecelglobal.com
TURNSTILE_HOSTNAMES=localhost

# --- E2E tests (Playwright) ----------------------------------------------------
# Defaults match supabase/seed.sql for local runs.
E2E_SEED_EMAIL=admin@telecel.local
E2E_SEED_PASSWORD=LocalAdmin#2026
