// Source of truth: supabase/migrations/*.sql (applied in filename order).
// Reflects tables, enums, indexes, FKs, and RLS policy notes only.
// Functions / triggers / RPCs: see Docs/supabase-functions.md

Enum user_role {
  admin
  editor
  viewer
}

Table profiles {
  id uuid [pk, not null, note: 'FK → auth.users(id) ON DELETE CASCADE']
  email text [not null]
  full_name text
  role user_role [not null, default: 'admin', note: 'Column default admin; new rows from signup use handle_new_user (app_metadata.app_role, else viewer)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (role) [name: 'profiles_role_idx']
    (created_at, id) [name: 'profiles_created_at_id_idx', note: 'created_at DESC, id — list/pagination']
    email [type: gin, name: 'profiles_email_trgm_idx', note: 'pg_trgm gin_trgm_ops']
    full_name [type: gin, name: 'profiles_full_name_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    RLS enabled.

    Grants:
    - authenticated: SELECT, UPDATE
    - service_role: SELECT
    - schema public USAGE: anon, authenticated, service_role

    Policies (authenticated):
    - Users can read own profile — SELECT USING (auth.uid() = id)
    - Users can update own profile — UPDATE USING/WITH CHECK (auth.uid() = id)
    - Admins can read all profiles — SELECT USING (is_admin())
    - Admins can update all profiles — UPDATE USING/WITH CHECK (is_admin())

    Role changes on own-profile UPDATE are blocked by trigger profiles_protect_role
    (only is_admin() may change role). Auth user create/delete via Admin API;
    profile insert via handle_new_user; delete via FK cascade.
  '''
}

Table interest_registrations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  full_name text [not null]
  email text [not null]
  phone text [not null]
  company_name text [not null]
  sector text [not null, note: 'Free text for now']
  country text [not null, note: 'Free text for now']
  pitch text [not null]
  consent boolean [not null, note: 'CHECK (consent = true)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'interest_registrations_created_at_idx', note: 'created_at DESC — admin lists']
    (email) [name: 'interest_registrations_email_idx']
    (email, company_name) [name: 'interest_registrations_email_company_uidx', note: 'UNIQUE lower(email), lower(company_name)']
  }

  Note: '''
    RLS enabled.

    Grants:
    - authenticated: SELECT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - no grants to anon (public cannot write via PostgREST)

    Policies (authenticated):
    - Admins can read interest registrations — SELECT USING (is_admin())
    - Admins can update interest registrations — UPDATE USING/WITH CHECK (is_admin())
    - Admins can delete interest registrations — DELETE USING (is_admin())

    Public inserts only via Server Action + service role client.
    App validates with Zod before insert/update; consent must stay true.
  '''
}

Table contact_messages {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  full_name text [not null, note: 'CHECK char_length between 2 and 100']
  email text [not null, note: 'CHECK char_length between 3 and 254']
  phone text [not null, note: 'CHECK char_length between 7 and 20']
  subject text [not null, note: 'CHECK char_length between 2 and 120']
  message text [not null, note: 'CHECK char_length between 20 and 2000']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'contact_messages_created_at_idx', note: 'created_at DESC — admin lists']
    (email) [name: 'contact_messages_email_idx']
  }

  Note: '''
    RLS enabled.

    Grants:
    - authenticated: SELECT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE
    - no grants to anon (public cannot write via PostgREST)

    Policies (authenticated):
    - Admins can read contact messages — SELECT USING (is_admin())
    - Admins can update contact messages — UPDATE USING/WITH CHECK (is_admin())
    - Admins can delete contact messages — DELETE USING (is_admin())

    CHECKs: contact_messages_*_len_chk on full_name, email, phone, subject, message
    (aligned with validations/contact-message.ts).

    No unique (email, subject) — follow-ups allowed; spam throttled by app rate limits.
    Public inserts only via Server Action + service role client.
    App validates with Zod before insert/update.
  '''
}

Enum blog_status {
  draft
  published
}

Table blogs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  slug text [not null, note: 'UNIQUE; URL-safe lowercase']
  title text [not null]
  summary text [not null]
  body_html text [not null, default: '']
  categories text[] [not null, default: '{}', note: 'Free-text labels; first drives public tab filter']
  thumbnail_url text [note: 'Storage bucket blogs']
  author_name text [not null]
  author_avatar_url text [note: 'Storage bucket auther']
  status blog_status [not null, default: 'draft']
  is_featured boolean [not null, default: false, note: 'At most one true — partial unique index']
  reading_time_minutes integer [not null, default: 1]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (slug) [unique, name: 'blogs_slug_uidx']
    (is_featured) [unique, name: 'blogs_one_featured_uidx', note: 'WHERE is_featured = true']
    (status, published_at) [name: 'blogs_status_published_at_idx', note: 'published_at DESC']
    (created_at) [name: 'blogs_created_at_idx', note: 'created_at DESC']
    categories [type: gin, name: 'blogs_categories_gin_idx']
  }

  Note: '''
    RLS enabled.

    Grants:
    - anon, authenticated: SELECT
    - authenticated: INSERT, UPDATE, DELETE
    - service_role: SELECT, INSERT, UPDATE, DELETE

    Policies:
    - Anyone can read published blogs — SELECT USING (status = published)
    - Admins can read all blogs — SELECT USING (is_admin())
    - Admins can insert/update/delete — is_admin()

    Storage buckets (public read, admin write):
    - blogs — cover/thumbnail images
    - auther — author avatars

    Trigger: blogs_set_updated_at BEFORE UPDATE
    English-only content phase 1; EN/FR public pages show the same posts.
  '''
}

// auth.users lives in Supabase auth schema (not managed in public migrations).
Table "auth.users" {
  id uuid [pk]

  Note: 'Managed by Supabase Auth. Referenced only; not defined in public migrations.'
}

Ref: profiles.id > "auth.users".id [delete: cascade]
