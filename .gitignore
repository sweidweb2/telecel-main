# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets (keep .env.example only)
.env
.env.*
!.env.example

# Supabase CLI local state
/supabase/.branches/
/supabase/.temp/
/supabase/.env.keys

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# confidential client material — repo is public (see docs/client/README.md)
/docs/client/*
!/docs/client/README.md
